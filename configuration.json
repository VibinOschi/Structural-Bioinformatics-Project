{
  "dataset_path": "dataset/",
  "predictor_model_path": "model/",

  "feature_columns": ["s_ss8", "s_rsa", "s_phi", "s_psi", "s_a1", "s_a2", "s_a3", "s_a4", "s_a5", "s_3di_state", "t_ss8", "t_rsa", "t_phi", "t_psi", "t_a1","t_a2", "t_a3", "t_a4", "t_a5", "t_3di_state"],
  "label_column": "Interaction",

  "rand_seed": 42,
