  "dropout": 0.1,
  "focal_gamma": 2.0,
  "learning_rate": 1e-3,
  "weight_decay": 1e-4,

  "number_of_epochs": 30,
  "early_stopping_patience": 5,

  "----------------------": "----------------------",

  "pdb_directory": "predict/input_pdb/",
